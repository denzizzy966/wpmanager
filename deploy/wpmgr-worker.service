[Unit]
Description=WP Manager worker
After=network.target postgresql.service

[Service]
User=wpmgr
WorkingDirectory=/opt/wpmgr
EnvironmentFile=/opt/wpmgr/.env
ExecStart=/opt/wpmgr/.venv/bin/python -m wpmgr.worker
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
