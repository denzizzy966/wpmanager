acak() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

nama_db() { printf 'stg_%s' "${1//-/_}"; }

sbg_pengguna() { dibatasi setpriv --reuid="$UID_W" --regid="$GID_W" --clear-groups -- "$@"; }

# Kebalikan jalur_daemon: path sumber mount dari `docker inspect` ke path lokal.
jalur_lokal() {
