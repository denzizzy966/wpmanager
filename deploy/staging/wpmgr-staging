  if [[ -n "$AKAR_DAEMON" && -n "$AKAR_LOKAL" && "$p" == "$AKAR_DAEMON"/* ]]; then
    printf '%s%s' "$AKAR_LOKAL" "${p#"$AKAR_DAEMON"}"
