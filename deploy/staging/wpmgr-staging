# Di bash, `$` di [[ =~ ]] hanya cocok di akhir string, dan kelas karakter
# ASCII (LC_ALL=C) tidak memuat baris baru, jadi argumen "nama\n" gagal.

cek_nama() { [[ "${1-}" =~ ^[a-z0-9-]{1,40}$ ]] || galat argumen "nama staging tidak sah"; }
cek_id() {
  [[ "${1-}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || galat argumen "id site tidak sah"
}
cek_versi() {
  local v
  for v in "${VERSI_PHP[@]}"; do
    [[ "${1-}" == "$v" ]] && return 0
  done
  galat argumen "versi PHP tidak didukung"
}
cek_prefix() { [[ "${1-}" =~ ^[A-Za-z0-9_]{1,20}$ ]] || galat argumen "prefix tabel tidak sah"; }
cek_url() {
  [[ "${1-}" =~ ^https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,200})?$ ]] || galat argumen "URL tidak sah"
}
cek_slug() { [[ "${1-}" =~ ^[a-z0-9][a-z0-9._-]{0,99}$ ]] || galat argumen "slug paket tidak sah"; }

# Nama situs produksi maksimal 36, supaya host pratinjau vps-<nama> tetap <= 40
# (batas cek_nama untuk `sertifikat`).
cek_nama_prod() { [[ "${1-}" =~ ^[a-z0-9-]{1,36}$ ]] || galat argumen "nama situs tidak sah"; }
cek_domain() {
  local d="${1-}"
  [[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]] || galat argumen "domain tidak sah"
  (( ${#d} <= 253 )) || galat argumen "domain tidak sah"
  [[ "$d" != www.* ]] || galat argumen "domain tidak boleh diawali www."
  [[ "$d" != "$DOMAIN" && "$d" != *".$DOMAIN" ]] || galat argumen "domain tidak boleh di bawah domain staging"
}
cek_www() { [[ "${1-}" =~ ^[01]$ ]] || galat argumen "penanda www tidak sah"; }
cek_stempel() { [[ "${1-}" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || galat argumen "stempel backup tidak sah"; }
butuh_hosting() { [[ -n "$HOSTING_DIR" ]] || galat konfigurasi "hosting tidak dikonfigurasi (HOSTING_DIR kosong)"; }

# Putusan F2: sumber bind mount di bawah STAGING_DIR harus direktori asli
# (bukan symlink) milik UID_W di setiap komponennya. Tanpa ini user dashboard
# bisa mengganti files/ dengan symlink ke /etc dan Docker (root) akan
# memasangnya ke container.
cek_mount_pengguna() {
  local jalur="$1" basis="${2:-$STAGING_DIR}" sisa p komponen pemilik bagian
  [[ "$jalur" == "$basis"/* ]] || galat ditolak "direktori staging tidak sah"
  sisa="${jalur#"$basis"/}"
  p="$basis"
  IFS=/ read -r -a komponen <<< "$sisa"
  for bagian in "${komponen[@]}"; do
    [[ -n "$bagian" && "$bagian" != . && "$bagian" != .. ]] || galat ditolak "direktori staging tidak sah"
    p="$p/$bagian"
    [[ -d "$p" && ! -L "$p" ]] || galat ditolak "direktori staging bukan direktori asli"
    pemilik="$(stat -c %u -- "$p")" || galat ditolak "direktori staging tidak terbaca"
    [[ "$pemilik" == "$UID_W" ]] || galat ditolak "direktori staging bukan milik user dashboard"
  done
}

# Sumber bind mount milik root (konfigurasi router, log, wp-cli) di bawah
# basis milik root (KONF_DIR/LOG_DIR): basis dan setiap komponen sesudahnya
# bukan symlink dan milik root; komponen terakhir berjenis d/f sesuai jenis.
cek_mount_root() {
  local jalur="$1" jenis="$2" basis="$3" p sisa komponen bagian pemilik
  [[ "$jalur" == "$basis" || "$jalur" == "$basis"/* ]] || galat ditolak "sumber mount tidak sah"
  p="$basis"
  komponen=()
  if [[ "$jalur" != "$basis" ]]; then
    sisa="${jalur#"$basis"/}"
    IFS=/ read -r -a komponen <<< "$sisa"
  fi
  while :; do
    [[ ! -L "$p" ]] || galat ditolak "sumber mount tidak sah"
    pemilik="$(stat -c %u -- "$p" 2>/dev/null)" || galat ditolak "sumber mount tidak terbaca"
    [[ "$pemilik" == 0 ]] || galat ditolak "sumber mount bukan milik root"
    if [[ "$p" == "$jalur" ]]; then
      break
    fi
    [[ -d "$p" ]] || galat ditolak "sumber mount tidak sah"
    bagian="${komponen[0]-}"
    komponen=("${komponen[@]:1}")
    [[ -n "$bagian" && "$bagian" != . && "$bagian" != .. ]] || galat ditolak "sumber mount tidak sah"
    p="$p/$bagian"
  done
  if [[ "$jenis" == d ]]; then
    [[ -d "$jalur" ]] || galat ditolak "sumber mount tidak sah"
  else
    [[ -f "$jalur" ]] || galat ditolak "sumber mount tidak sah"
  fi
}

