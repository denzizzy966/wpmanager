#!/usr/bin/env bash
# wpmgr-staging -- satu-satunya jembatan dashboard WP Manager ke Docker
# (spec §7.3). Dijalankan root lewat `sudo -n` oleh user dashboard.
#
# Aturan skrip ini:
#   - setiap argumen divalidasi dengan pola tetap sebelum dipakai;
#   - perintah Docker selalu disusun sebagai array, tidak pernah lewat eval
#     atau string yang diurai ulang oleh shell;
#   - berkas di direktori milik user dashboard dibaca/ditulis SEBAGAI user
#     itu (setpriv), karena ia bisa mengganti apa pun di sana dengan symlink;
#   - direktori yang di-bind mount diperiksa root dulu: direktori asli, bukan
#     symlink, dengan pemilik yang diharapkan (putusan F2);
#   - container site seluruhnya berjalan sebagai UID dashboard tanpa
#     capability, sehingga mount yang ditukar di sela pemeriksaan tidak memberi
#     akses lebih dari yang sudah dimiliki user itu di host (putusan R13);
#   - container yang labelnya bukan milik staging tidak pernah disentuh,
#     termasuk layanan bersama db/router/mail (RF5, putusan F14);
#   - setiap panggilan docker/certbot/setpriv dibatasi `timeout` terhadap
#     tenggat milik skrip ini sendiri per subperintah (putusan F10b). Skrip
#     tidak mendeteksi kematian pemanggilnya; bila pemanggil mati tanpa
#     menghentikannya, proses root ini tetap berakhir paling lambat pada
#     tenggat itu (ditambah jeda -k 10 detik);
#   - pesan galat tetap dan pendek, tidak pernah menggemakan masukan mentah.
#
# Kode keluar (stderr: satu baris `GALAT <kode>: <pesan>`):
#   2 argumen, 3 ditolak, 4 docker, 5 sertifikat, 6 impor, 7 konfigurasi,
#   8 wpcli, 9 internal (kegagalan tak terduga yang tertangkap `set -e`;
#   kode keluar mentah perintah seperti awk/install tidak pernah diteruskan),
#   10 nginx (uji/reload nginx host gagal; berkas lama dipulihkan), 11 backup.
set -Eeuo pipefail
umask 077
export LC_ALL=C
PATH="${WPMGR_STG_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
KONF="${WPMGR_STG_KONF:-/etc/wpmgr-staging/staging.conf}"

VERSI_PHP=(7.4 8.0 8.1 8.2 8.3)
WPCLI_VERSI="2.11.0"
JARINGAN="wpmgr-staging"
JEMBATAN="br-wpmgrstg"
JARINGAN_PROD="wpmgr-prod"
JEMBATAN_PROD="br-wpmgrprod"
# Container db tempat berkas opsi klien MariaDB sedang dibuat (lihat
# opsi_klien); dipakai jebakan EXIT untuk menghapusnya.
OPSI_WADAH="wpmgr-stg-db"
OPSI_KLIEN=""
SEMENTARA=()

# Tenggat per subperintah = tenggat pembungkus Python (pembantu.py
# TIMEOUT_*) ditambah margin, supaya dalam keadaan normal pembungkus yang
# lebih dulu menyerah. Batas ini berlaku apa pun yang terjadi pada pemanggil.
WAKTU_BAWAAN=180       # TIMEOUT_BAWAAN 120 + 60
WAKTU_SIAPKAN=960      # TIMEOUT_SIAPKAN 900 + 60
WAKTU_BUAT=660         # TIMEOUT_BUAT 600 + 60
WAKTU_IMPOR=11100      # TIMEOUT_IMPOR 3 jam + 300
WAKTU_WPCLI=960        # TIMEOUT_WPCLI 900 + 60
WAKTU_SERTIFIKAT=360   # TIMEOUT_SERTIFIKAT 300 + 60
WAKTU_AKTIFKAN=360     # TIMEOUT_AKTIFKAN 300 + 60
TENGGAT=$(( SECONDS + WAKTU_BAWAAN ))

ROUTER_CADANGAN=""
# Router yang sedang dipasang ulang: KONF_DIR/router + awalan stg- (staging)
# atau KONF_DIR/prod/router + awalan prd- (produksi).
ROUTER_TUJUAN=""
ROUTER_AWALAN="stg-"
# Deskriptor kunci router produksi; terisi sesudah kunci_router berhasil.
KUNCI_ROUTER_FD=""
# 1 sesudah kunci_nginx berhasil (fd 9 dipegang sampai skrip keluar).
KUNCI_NGINX_ADA=0
# Berkas nginx domain yang sedang diganti dan salinan lamanya (kosong = tidak
# ada berkas lama); dipulihkan jebakan EXIT selama NGINX_TUJUAN terisi.
NGINX_TUJUAN=""
NGINX_CADANGAN=""
# prod-aktifkan: 1 sesudah perubahan pertama (Koreksi #5).
SUDAH_BERUBAH=0
# Penanda "baris GALAT sudah dicetak". Berupa berkas, bukan variabel, karena
# galat bisa terjadi di subshell substitusi perintah; tanpa penanda ini
# jebakan ERR di induknya akan mencetak GALAT kedua dan menimpa kodenya.
PENANDA_GALAT="$(mktemp)"

galat() {
  local kode="$1"
  shift
  # prod-aktifkan: sesudah perubahan pertama, "ditolak" tidak lagi berarti
  # "tanpa perubahan" (kontrak keluar 3 yang dipakai dashboard untuk
  # menghapus penanda tulis-lebih-dulu), jadi dilaporkan sebagai internal.
  if [[ "$kode" == ditolak && "$SUDAH_BERUBAH" == 1 ]]; then
    kode=internal
  fi
  printf 'GALAT %s: %s\n' "$kode" "$*" >&2
  printf '1' > "$PENANDA_GALAT" 2>/dev/null || true
  case "$kode" in
    argumen) exit 2 ;;
    ditolak) exit 3 ;;
    docker) exit 4 ;;
    sertifikat) exit 5 ;;
    impor) exit 6 ;;
    konfigurasi) exit 7 ;;
    wpcli) exit 8 ;;
    nginx) exit 10 ;;
    backup) exit 11 ;;
    *) exit 9 ;;
  esac
}

# Jebakan ERR (diwarisi fungsi dan subshell lewat `set -E`): kegagalan yang
# tidak ditangani eksplisit menjadi `GALAT internal` dengan kode 9. Bila baris
# GALAT sudah dicetak (galat() di subshell), kodenya dipertahankan.
galat_tak_terduga() {
  local rc=$?
  trap - ERR
  if [[ -s "$PENANDA_GALAT" ]]; then
    exit "$rc"
  fi
  galat internal "kegagalan tak terduga"
}
trap galat_tak_terduga ERR

# Mengembalikan konfigurasi router lama; dipanggil dari jebakan EXIT selama
# ROUTER_CADANGAN terisi, sebelum direktori sementara (cadangannya) dihapus.
pulihkan_router() {
  local tujuan="${ROUTER_TUJUAN:-$KONF_DIR/router}"
  rm -f "$tujuan/conf.d/${ROUTER_AWALAN}"*.conf "$tujuan/htpasswd/"* 2>/dev/null || true
  cp -a "$ROUTER_CADANGAN/conf.d/." "$tujuan/conf.d/" 2>/dev/null || true
  cp -a "$ROUTER_CADANGAN/htpasswd/." "$tujuan/htpasswd/" 2>/dev/null || true
  ROUTER_CADANGAN=""
}

bersihkan() {
  local rc=$?
  # Pembersihan tidak boleh terpotong: SIGTERM/SIGINT di tengah
  # pulihkan_router akan meninggalkan conf.d router kosong.
  trap '' TERM INT
  trap - ERR
  if [[ -n "$ROUTER_CADANGAN" ]]; then
    pulihkan_router
  fi
  # Berkas nginx domain yang belum lolos uji/reload dikembalikan; kunci nginx
  # masih dipegang (fd 9 baru tertutup saat proses berakhir).
  if [[ -n "$NGINX_TUJUAN" ]]; then
    pulihkan_nginx
  fi
  # Berkas opsi klien MariaDB memuat kata sandi: selalu dihapus, juga saat
  # skrip berhenti karena galat. Batas waktunya sendiri, bukan sisa tenggat,
  # supaya tenggat yang habis tidak mencegah pembersihan.
  if [[ -n "$OPSI_KLIEN" ]]; then
    timeout -k 5 20 docker exec "$OPSI_WADAH" rm -f "$OPSI_KLIEN" >/dev/null 2>&1 || true
  fi
  if [[ ${#SEMENTARA[@]} -gt 0 ]]; then
    rm -rf -- "${SEMENTARA[@]}" || true
  fi
  rm -f -- "$PENANDA_GALAT" || true
  exit "$rc"
}
trap bersihkan EXIT

# ---- batas waktu ---------------------------------------------------------

atur_tenggat() { TENGGAT=$(( SECONDS + $1 )); }

# Pid `timeout` yang sedang ditunggu di shell utama (kosong bila tidak ada).
ANAK=""

# Menjalankan perintah dengan sisa tenggat subperintah ini.
#
# Dijalankan di latar lalu ditunggu dengan `wait`: bash menunda jebakan sinyal
# sampai perintah latar depan selesai, sedangkan `wait` langsung terinterupsi.
# Dengan begitu SIGTERM dari dashboard (diteruskan sudo ke skrip ini) segera
# diteruskan ke `timeout`, yang meneruskannya ke perintahnya (putusan F10a).
# `<&0` wajib: tanpa pengalihan eksplisit, perintah latar di shell
# non-interaktif mendapat stdin /dev/null dan `docker exec -i` tidak menerima SQL.
# Status keluarnya diteruskan apa adanya, jadi jebakan ERR dan `|| galat ...`
# pemanggil berlaku sama seperti sebelumnya.
dibatasi() {
  local sisa=$(( TENGGAT - SECONDS )) rc=0
  (( sisa > 0 )) || galat docker "tenggat habis"
  timeout -k 10 "$sisa" "$@" <&0 &
  ANAK=$!
  wait "$ANAK" || rc=$?
  ANAK=""
  return "$rc"
}

# SIGTERM/SIGINT (dashboard menghentikan panggilan yang melewati tenggatnya):
# teruskan ke perintah yang sedang berjalan, lalu keluar lewat jalur galat
# tetap supaya jebakan EXIT tetap membersihkan berkas opsi klien dan cadangan
# router. Hanya berlaku di shell utama; subshell substitusi perintah berakhir
# bersama pipanya.
dihentikan() {
  trap - TERM INT
  if [[ -n "$ANAK" ]]; then
    kill -TERM "$ANAK" 2>/dev/null || true
  fi
  galat internal "dihentikan oleh pemanggil"
}
trap dihentikan TERM INT

dk() { dibatasi docker "$@"; }

# ---- konfigurasi ---------------------------------------------------------

POLA_JALUR='^/[A-Za-z0-9._/-]{1,200}$'
# Nama grup Unix: awali huruf kecil/garis bawah, lalu huruf kecil/angka/garis
# bawah/strip, maksimal 32 karakter (batas groupadd umum di Linux).
POLA_GRUP='^[a-z_][a-z0-9_-]{0,31}$'

muat_konf() {
  [[ -r "$KONF" ]] || galat konfigurasi "berkas konfigurasi tidak ada"
  local baris kunci nilai
  while IFS= read -r baris || [[ -n "$baris" ]]; do
    [[ -z "$baris" || "$baris" == \#* ]] && continue
    [[ "$baris" =~ ^([A-Z_]+)=(.*)$ ]] || galat konfigurasi "baris konfigurasi tidak dikenal"
    kunci="${BASH_REMATCH[1]}"
    nilai="${BASH_REMATCH[2]}"
    case "$kunci" in
      DOMAIN|STAGING_DIR|KONF_DIR|CERT_DIR|ACME_DIR|LE_DIR|LOG_DIR|ACME_EMAIL|ROUTER_PORT|MAIL_PORT|SUBNET|\
PENGGUNA_UID|PENGGUNA_GID|AKAR_LOKAL|AKAR_DAEMON|TANPA_IPTABLES|TANPA_SERTIFIKAT|MEMINFO|BRNF|NGINX_GROUP|HOSTING_DIR|PROD_SUBNET|PROD_ROUTER_PORT|PROD_CERT_DIR|NGINX_HOSTING_DIR|BACKUP_DIR|IP_PUBLIK|NGINX_UJI_SAJA|SERTIFIKAT_SENDIRI)
        printf -v "K_$kunci" '%s' "$nilai" ;;
      *) galat konfigurasi "kunci konfigurasi tidak dikenal" ;;
    esac
  done < "$KONF"

  DOMAIN="${K_DOMAIN:-}"
  STAGING_DIR="${K_STAGING_DIR:-/var/lib/wpmgr/staging}"
  KONF_DIR="${K_KONF_DIR:-/etc/wpmgr-staging}"
  CERT_DIR="${K_CERT_DIR:-/var/lib/wpmgr/certs}"
  ACME_DIR="${K_ACME_DIR:-/var/lib/wpmgr/acme}"
  LE_DIR="${K_LE_DIR:-/var/lib/wpmgr/letsencrypt}"
  LOG_DIR="${K_LOG_DIR:-/var/log/wpmgr-staging}"
  ACME_EMAIL="${K_ACME_EMAIL:-}"
  ROUTER_PORT="${K_ROUTER_PORT:-127.0.0.1:8090}"
  MAIL_PORT="${K_MAIL_PORT:-127.0.0.1:8025}"
  SUBNET="${K_SUBNET:-172.31.250.0/24}"
  AKAR_LOKAL="${K_AKAR_LOKAL:-}"
  AKAR_DAEMON="${K_AKAR_DAEMON:-}"
  TANPA_IPTABLES="${K_TANPA_IPTABLES:-0}"
  TANPA_SERTIFIKAT="${K_TANPA_SERTIFIKAT:-0}"
  MEMINFO="${K_MEMINFO:-/proc/meminfo}"
  # Kait test: berkas sysctl br_netfilter (lihat pastikan_brnf).
  BRNF="${K_BRNF:-/proc/sys/net/bridge/bridge-nf-call-iptables}"
  # Grup pemilik kunci privat sertifikat staging (putusan review Task 21):
  # worker nginx host (bukan master, yang start sebagai root) yang membaca
  # ssl_certificate_key berbasis variabel, jadi kunci itu harus terbaca
  # grupnya, bukan cuma root.
  NGINX_GROUP="${K_NGINX_GROUP:-www-data}"
  LOCK="$KONF_DIR/digest.lock"
  # Produksi (Lapis 4). HOSTING_DIR kosong = semua subperintah prod-* mati.
  HOSTING_DIR="${K_HOSTING_DIR:-}"
  PROD_SUBNET="${K_PROD_SUBNET:-172.31.251.0/24}"
  PROD_ROUTER_PORT="${K_PROD_ROUTER_PORT:-127.0.0.1:8091}"
  PROD_CERT_DIR="${K_PROD_CERT_DIR:-/var/lib/wpmgr/hosting-certs}"
  NGINX_HOSTING_DIR="${K_NGINX_HOSTING_DIR:-/etc/nginx/wpmgr-hosting}"
  BACKUP_DIR="${K_BACKUP_DIR:-/var/lib/wpmgr/backup}"
  IP_PUBLIK="${K_IP_PUBLIK:-}"
  # Kait test: nginx -t tanpa reload, dan sertifikat self-signed lewat openssl.
  NGINX_UJI_SAJA="${K_NGINX_UJI_SAJA:-0}"
  SERTIFIKAT_SENDIRI="${K_SERTIFIKAT_SENDIRI:-0}"
  KONF_PROD="$KONF_DIR/prod"

  [[ "$DOMAIN" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] \
    || galat konfigurasi "DOMAIN tidak sah"
  # Path dipakai di `-v sumber:tujuan` dan `--mount type=bind,src=…`; titik
  # dua, koma, spasi, atau `..` akan mengubah arti argumen itu, jadi hanya
  # karakter aman yang diterima.
  local p
  for p in "$STAGING_DIR" "$KONF_DIR" "$CERT_DIR" "$ACME_DIR" "$LE_DIR" "$LOG_DIR" "$MEMINFO" "$BRNF"            "$PROD_CERT_DIR" "$NGINX_HOSTING_DIR" "$BACKUP_DIR"; do
    [[ "$p" =~ $POLA_JALUR && "$p" != *..* ]] || galat konfigurasi "path konfigurasi tidak sah"
  done
  if [[ -n "$AKAR_LOKAL" || -n "$AKAR_DAEMON" ]]; then
    [[ "$AKAR_LOKAL" =~ $POLA_JALUR && "$AKAR_LOKAL" != *..* && "$AKAR_DAEMON" =~ $POLA_JALUR && "$AKAR_DAEMON" != *..* ]] \
      || galat konfigurasi "AKAR_LOKAL/AKAR_DAEMON tidak sah"
  fi
  [[ -z "$ACME_EMAIL" || "$ACME_EMAIL" =~ ^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}$ ]] \
    || galat konfigurasi "ACME_EMAIL tidak sah"
  [[ "$ROUTER_PORT" =~ ^127\.0\.0\.1:[0-9]{2,5}$ && "$MAIL_PORT" =~ ^127\.0\.0\.1:[0-9]{2,5}$ ]] \
    || galat konfigurasi "port router/mail harus di 127.0.0.1"
  [[ "$SUBNET" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || galat konfigurasi "SUBNET tidak sah"
  hitung_ip_layanan
  [[ "$NGINX_UJI_SAJA" =~ ^[01]$ && "$SERTIFIKAT_SENDIRI" =~ ^[01]$ ]] || galat konfigurasi "kait test hosting tidak sah"
  # Pemeriksaan produksi hanya berlaku bila hosting dinyalakan (HOSTING_DIR
  # terisi): instalasi staging-saja tidak boleh mulai gagal gara-gara
  # PROD_SUBNET bawaan beririsan dengan SUBNET-nya.
  if [[ -n "$HOSTING_DIR" ]]; then
    [[ "$PROD_ROUTER_PORT" =~ ^127\.0\.0\.1:[0-9]{2,5}$ ]] || galat konfigurasi "PROD_ROUTER_PORT harus di 127.0.0.1"
    [[ "$PROD_SUBNET" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || galat konfigurasi "PROD_SUBNET tidak sah"
    hitung_ip_prod
    [[ "$HOSTING_DIR" =~ $POLA_JALUR && "$HOSTING_DIR" != *..* ]] || galat konfigurasi "path konfigurasi tidak sah"
    for p in "$HOSTING_DIR" "$STAGING_DIR" "$KONF_DIR" "$BACKUP_DIR" "$PROD_CERT_DIR" "$NGINX_HOSTING_DIR"; do
      jalur_bersih "$p"
    done
    # Pemangkasan staging menghapus setiap direktori UUID di STAGING_DIR yang
    # tidak punya baris Staging; situs produksi tidak boleh berada di sana
    # (RFP1), dan sebaliknya.
    if di_dalam "$HOSTING_DIR" "$STAGING_DIR" || di_dalam "$STAGING_DIR" "$HOSTING_DIR"; then
      galat konfigurasi "HOSTING_DIR tidak boleh berimpit dengan STAGING_DIR"
    fi
    # Direktori tulis-root tidak boleh berada di pohon yang bisa diubah
    # container/dashboard maupun di pohon yang dipangkas staging.
    for p in "$KONF_DIR" "$BACKUP_DIR" "$PROD_CERT_DIR" "$NGINX_HOSTING_DIR"; do
      if di_dalam "$p" "$HOSTING_DIR" || di_dalam "$p" "$STAGING_DIR"; then
        galat konfigurasi "direktori milik root tidak boleh di dalam HOSTING_DIR atau STAGING_DIR"
      fi
    done
    [[ -n "$IP_PUBLIK" ]] || galat konfigurasi "IP_PUBLIK wajib diisi bila HOSTING_DIR diisi"
    [[ "$IP_PUBLIK" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || galat konfigurasi "IP_PUBLIK tidak sah"
    angka_ip "$IP_PUBLIK" >/dev/null
  fi
  [[ "$NGINX_GROUP" =~ $POLA_GRUP ]] || galat konfigurasi "NGINX_GROUP tidak sah"
  # gid_nginx dipakai lagi di bawah (sesudah GID_W ada) tanpa memanggil
  # getent group sekali lagi.
  local gid_nginx
  gid_nginx="$(getent group "$NGINX_GROUP" 2>/dev/null | cut -d: -f3)" \
    || galat konfigurasi "grup NGINX_GROUP tidak ada di sistem"
  [[ "$gid_nginx" =~ ^[0-9]+$ ]] || galat konfigurasi "grup NGINX_GROUP tidak terbaca"
  (( gid_nginx != 0 )) || galat konfigurasi "NGINX_GROUP tidak boleh grup root"

  if [[ -n "${K_PENGGUNA_UID:-}" ]]; then
    UID_W="$K_PENGGUNA_UID"
    GID_W="${K_PENGGUNA_GID:-$K_PENGGUNA_UID}"
  else
    UID_W="$(stat -c %u "$STAGING_DIR" 2>/dev/null)" || galat konfigurasi "STAGING_DIR tidak ada"
    GID_W="$(stat -c %g "$STAGING_DIR" 2>/dev/null)" || galat konfigurasi "STAGING_DIR tidak ada"
  fi
  [[ "$UID_W" =~ ^[0-9]{1,10}$ && "$GID_W" =~ ^[0-9]{1,10}$ ]] || galat konfigurasi "UID/GID pengguna tidak sah"
  # Dibandingkan secara numerik (10#: "00" dan "0000" juga root) lalu
  # dinormalkan, karena nilainya dibandingkan dengan keluaran `stat -c %u`.
  (( 10#$UID_W != 0 && 10#$GID_W != 0 )) || galat konfigurasi "pemilik STAGING_DIR tidak boleh root"
  UID_W=$(( 10#$UID_W ))
  GID_W=$(( 10#$GID_W ))

  # Lanjutan validasi NGINX_GROUP di atas (baru bisa dilakukan sesudah
  # GID_W ada; gid_nginx sudah diambil di atas, tidak perlu getent lagi).
  # privkey.pem staging dipasang 0640 root:$NGINX_GROUP (lihat
  # cmd_sertifikat), jadi SETIAP proses yang berjalan sebagai grup itu bisa
  # membacanya -- termasuk proses dashboard sendiri bila user dashboard
  # kebetulan anggota grup itu. NGINX_GROUP tidak boleh: grup root (gid 0,
  # sudah dicek di atas), grup UTAMA user dashboard (GID_W), atau grup
  # TAMBAHAN mana pun yang sudah dimiliki user dashboard (`id -G`) --
  # ketiganya membuat proses dashboard ikut bisa membaca kunci privat
  # staging mana pun (putusan review Task 21, putaran 2).
  (( gid_nginx != GID_W )) \
    || galat konfigurasi "NGINX_GROUP tidak boleh sama dengan grup utama pengguna dashboard"
  # UID_W diterjemahkan ke nama dulu: `id -G <uid>` tidak selalu diterima
  # (implementasi id sebagian menerima nama saja). Gagal TERTUTUP (putusan
  # review Task 21, putaran 3): "tidak ketemu" (rc 2) adalah satu-satunya
  # hasil yang sah untuk dilewati (hanya GID utama yang berlaku, sudah
  # dicek di atas) -- kode keluar lain dari getent/id (galat NSS, dsb.)
  # menggagalkan konfigurasi, tidak diam-diam dianggap "tidak ada anggota".
  # Tidak ada `|| true` di sini: setiap kegagalan yang bukan "tidak
  # ditemukan" harus tertangkap eksplisit, sesuai `set -euo pipefail`.
  local nama_dashboard rc=0
  nama_dashboard="$(getent passwd "$UID_W" 2>/dev/null | cut -d: -f1)" || rc=$?
  (( rc == 0 || rc == 2 )) || galat konfigurasi "pengguna dashboard tidak dapat diperiksa"
  if (( rc == 0 )); then
    local daftar_grup g
    daftar_grup="$(id -G "$nama_dashboard" 2>/dev/null)" \
      || galat konfigurasi "pengguna dashboard tidak dapat diperiksa"
    for g in $daftar_grup; do
      (( g != gid_nginx )) || galat konfigurasi "pengguna dashboard tidak boleh anggota NGINX_GROUP"
    done
  fi
}

# Alamat tetap layanan bersama di dalam SUBNET (putusan R25): tiga alamat
# host paling atas (broadcast-1 router, -2 mail, -3 db). Docker membagikan
# alamat dinamis container situs dari bawah (.2, .3, ...), jadi keduanya
# tidak bertabrakan. Aturan iptables antar-container memakai alamat ini.
ip_dari_angka() {
  printf '%d.%d.%d.%d' $(( ($1 >> 24) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 8) & 255 )) $(( $1 & 255 ))
}

hitung_ip_layanan() {
  local ip="${SUBNET%/*}" pref="${SUBNET#*/}" a b c d o masker jaringan siaran
  IFS=. read -r a b c d <<< "$ip"
  for o in "$a" "$b" "$c" "$d"; do
    (( 10#$o <= 255 )) || galat konfigurasi "SUBNET tidak sah"
  done
  (( 10#$pref >= 16 && 10#$pref <= 28 )) || galat konfigurasi "SUBNET harus berukuran /16 sampai /28"
  masker=$(( (0xFFFFFFFF << (32 - 10#$pref)) & 0xFFFFFFFF ))
  jaringan=$(( ((10#$a << 24) | (10#$b << 16) | (10#$c << 8) | 10#$d) & masker ))
  siaran=$(( jaringan | (~masker & 0xFFFFFFFF) ))
  IP_ROUTER="$(ip_dari_angka $(( siaran - 1 )))"
  IP_MAIL="$(ip_dari_angka $(( siaran - 2 )))"
  IP_DB="$(ip_dari_angka $(( siaran - 3 )))"
}

# Jalur harus sudah dinormalkan sebelum dibandingkan secara teks (awalan
# string): "//", "/./", akhiran "/" atau "/." membuat HOSTING_DIR=/a//b lolos
# dari pemeriksaan "di dalam STAGING_DIR" padahal menunjuk tempat yang sama.
jalur_bersih() {
  local j="$1"
  [[ "$j" != *//* && "$j" != */./* && "$j" != */ && "$j" != */. ]] || galat konfigurasi "path konfigurasi tidak dinormalkan"
}

# $1 jalur, $2 basis: benar bila $1 sama dengan atau di dalam $2.
di_dalam() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# IPv4 bertitik ke bilangan 32 bit; setiap oktet 0..255.
angka_ip() {
  local a b c d o
  IFS=. read -r a b c d <<< "$1"
  for o in "$a" "$b" "$c" "$d"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] || galat konfigurasi "alamat IPv4 tidak sah"
    (( 10#$o <= 255 )) || galat konfigurasi "alamat IPv4 tidak sah"
  done
  printf '%d' $(( (10#$a << 24) | (10#$b << 16) | (10#$c << 8) | 10#$d ))
}

# Alamat tetap layanan produksi di PROD_SUBNET (pola hitung_ip_layanan):
# broadcast-1 router, broadcast-3 db. PROD_SUBNET tidak boleh beririsan
# dengan SUBNET staging: isolasi antar-jembatan bergantung pada keduanya
# berbeda.
hitung_ip_prod() {
  local pref="${PROD_SUBNET#*/}" pref_stg="${SUBNET#*/}" n n_stg m jaringan siaran kecil
  n="$(angka_ip "${PROD_SUBNET%/*}")"
  (( 10#$pref >= 16 && 10#$pref <= 28 )) || galat konfigurasi "PROD_SUBNET harus berukuran /16 sampai /28"
  m=$(( (0xFFFFFFFF << (32 - 10#$pref)) & 0xFFFFFFFF ))
  jaringan=$(( n & m ))
  siaran=$(( jaringan | (~m & 0xFFFFFFFF) ))
  IP_PROD_ROUTER="$(ip_dari_angka $(( siaran - 1 )))"
  IP_PROD_DB="$(ip_dari_angka $(( siaran - 3 )))"
  n_stg="$(angka_ip "${SUBNET%/*}")"
  kecil=$(( 10#$pref < 10#$pref_stg ? 10#$pref : 10#$pref_stg ))
  m=$(( (0xFFFFFFFF << (32 - kecil)) & 0xFFFFFFFF ))
  (( (n & m) != (n_stg & m) )) || galat konfigurasi "PROD_SUBNET beririsan dengan SUBNET staging"
}

