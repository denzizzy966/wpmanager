    printf '%s' "$p"
  fi
}

jalur_daemon() {
  local p="$1"
  if [[ -n "$AKAR_DAEMON" && -n "$AKAR_LOKAL" && "$p" == "$AKAR_LOKAL"/* ]]; then
    printf '%s%s' "$AKAR_DAEMON" "${p#"$AKAR_LOKAL"}"
